# Casa Afeto — Production Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to the repository.
#
# NOTE: This configuration is optimized for low-memory environments (1 GB RAM).
# For production with more users, use at least 2 GB RAM.

# Database
POSTGRES_USER=casa_afeto
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=casa_afeto

# Backend
# Use your server IP initially, or your domain when available.
# Example with IP: ["http://129.123.45.67"]
# Example with domain: ["https://casaafeto.com.br"]
CORS_ORIGINS=["http://YOUR_SERVER_IP"]

# Backup (cron schedule, default: daily at 2 AM)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention (days, default: 7)
BACKUP_RETENTION=7
