# Casa Afeto — Production Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to the repository.

# Database
POSTGRES_USER=casa_afeto
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=casa_afeto

# Backend
CORS_ORIGINS=["https://YOUR_DOMAIN.com"]

# Nginx / Domain
NGINX_DOMAIN=YOUR_DOMAIN.com

# Certbot (Let's Encrypt)
CERTBOT_EMAIL=YOUR_EMAIL@example.com

# Backup (cron schedule, default: daily at 2 AM)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention (days, default: 7)
BACKUP_RETENTION=7
