# Application Environment (development, test, production)
ENVIRONMENT=development
PROJECT_NAME="Casa Afeto"
DEBUG=true

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=casa_afeto
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/casa_afeto

# CORS Configuration (JSON array or comma-separated list of origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Image Upload Configuration
# Base directory relative to backend/app/ (default: uploads)
# UPLOAD_DIR=uploads
# Max image size in bytes (default: 5242880 = 5 MB)
# MAX_IMAGE_SIZE=5242880

# Gemini OCR Configuration
# GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.8-flash
